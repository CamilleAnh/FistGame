<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/hinh_nen"
    tools:context=".FirstFragment">

    <!-- Dark Contrast Overlay -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#770F172A" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/safe_top_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_begin="36dp" />

    <!-- Top Bar Currency Header -->
    <LinearLayout
        android:id="@+id/ll_home_currencies"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/safe_top_guideline">

        <!-- Gold Display Pill -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/ui_pill_gold_3d"
            android:gravity="center_vertical"
            android:elevation="8dp"
            android:paddingStart="12dp"
            android:paddingEnd="14dp"
            android:layout_marginEnd="8dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🪙"
                android:textSize="16sp" />
            <TextView
                android:id="@+id/tv_home_gold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black" />
        </LinearLayout>

        <!-- Gems Display Pill -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/ui_pill_gem_3d"
            android:gravity="center_vertical"
            android:elevation="8dp"
            android:paddingStart="12dp"
            android:paddingEnd="14dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💎"
                android:textSize="16sp" />
            <TextView
                android:id="@+id/tv_home_gems"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black" />
        </LinearLayout>
    </LinearLayout>

    <!-- Title Card Header with Premium Glassmorphism -->
    <LinearLayout
        android:id="@+id/ll_title_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="28dp"
        android:layout_marginTop="56dp"
        android:gravity="center"
        android:orientation="vertical"
        android:background="@drawable/ui_glass_card_premium"
        android:paddingVertical="28dp"
        android:paddingHorizontal="20dp"
        android:elevation="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ll_home_currencies">

        <!-- Animated 3D Fruit Badge Row -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🍉  🍓  🍊"
            android:textSize="28sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tv_game_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:shadowColor="#FF6D00"
            android:shadowDx="0"
            android:shadowDy="6"
            android:shadowRadius="20"
            android:text="FRUIT SORT"
            android:gravity="center"
            android:fontFamily="sans-serif-black"
            android:textColor="#FFFFFF"
            android:textSize="44sp"
            android:letterSpacing="0.06" />

        <TextView
            android:id="@+id/tv_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="🌾 FARM &amp; PUZZLE EDITION 🌾"
            android:textColor="#FFD54F"
            android:textSize="13sp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.15" />
    </LinearLayout>

    <!-- Developer Test Buttons -->
    <LinearLayout
        android:id="@+id/ll_test_buttons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/ll_title_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btn_test_gold"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="+99999 Gold"
            android:textSize="10sp"
            android:layout_marginEnd="8dp"
            android:backgroundTint="#FF9800" />

        <Button
            android:id="@+id/btn_test_unlock"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Unlock All"
            android:textSize="10sp"
            android:backgroundTint="#4CAF50" />
    </LinearLayout>

    <!-- Main Navigation Menu Buttons -->
    <LinearLayout
        android:id="@+id/ll_menu"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="40dp"
        android:layout_marginBottom="40dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- PLAY NOW 3D Primary Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_play"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/ui_btn_primary_3d"
            android:text="▶   PLAY NOW"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:fontFamily="sans-serif-black"
            android:elevation="12dp" />

        <!-- SHOP & SKINS 3D Secondary Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_shop"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/ui_btn_secondary_3d"
            android:text="🛍️   SHOP &amp; SKINS"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:fontFamily="sans-serif-black"
            android:elevation="8dp" />

        <!-- SETTINGS Glass Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_settings"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:background="@drawable/ui_glass_card_premium"
            android:text="⚙️   SETTINGS"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:fontFamily="sans-serif-black"
            android:elevation="6dp" />

        <!-- Privacy Policy -->
        <TextView
            android:id="@+id/tv_privacy_policy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:text="Privacy Policy"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:padding="8dp" />

    </LinearLayout>

    <!-- Settings Overlay -->
    <include
        android:id="@+id/layout_settings"
        layout="@layout/dialog_settings"
        android:visibility="gone" />

</androidx.constraintlayout.widget.ConstraintLayout>
