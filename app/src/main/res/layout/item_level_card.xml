<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="76dp"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="5dp"
    app:cardBackgroundColor="#FFF3E0"
    app:cardCornerRadius="18dp"
    app:cardElevation="5dp"
    app:strokeColor="#FFCC80"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="14dp">

        <!-- Level number badge (orange circle) -->
        <TextView
            android:id="@+id/tv_level_badge"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/level_badge_bg"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:elevation="2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Fruit / vegetable emoji icon -->
        <TextView
            android:id="@+id/tv_fruit_icon"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="10dp"
            android:gravity="center"
            android:textSize="28sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/tv_level_badge"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Level name text -->
        <TextView
            android:id="@+id/tv_level_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="#6D4C41"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tv_stars"
            app:layout_constraintStart_toEndOf="@id/tv_fruit_icon"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Stars row (⭐⭐⭐ or ☆☆☆ or empty) -->
        <TextView
            android:id="@+id/tv_stars"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:textSize="16sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/iv_lock_icon"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Lock icon (visible when locked) -->
        <ImageView
            android:id="@+id/iv_lock_icon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginEnd="4dp"
            android:src="@drawable/ic_lock"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#90A4AE" />

        <!-- Grey overlay when locked -->
        <View
            android:id="@+id/lock_overlay"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="#99B0BEC5"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
