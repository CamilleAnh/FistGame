<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/hinh_nen"
    tools:context=".IntroFragment">

    <!-- Soft Overlay -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#660F172A" />

    <!-- Game Title with Glassmorphism Card -->
    <LinearLayout
        android:id="@+id/ll_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="36dp"
        android:layout_marginTop="80dp"
        android:gravity="center"
        android:orientation="vertical"
        android:background="@drawable/ui_glass_card"
        android:paddingVertical="28dp"
        android:elevation="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tv_title_main"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:shadowColor="#FF6D00"
            android:shadowDx="0"
            android:shadowDy="4"
            android:shadowRadius="16"
            android:text="FRUIT SORT"
            android:textColor="#FFFFFF"
            android:textSize="44sp"
            android:letterSpacing="0.05" />

        <TextView
            android:id="@+id/tv_title_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif-black"
            android:text="🌾 FARM PUZZLE 🌾"
            android:textColor="#FFD54F"
            android:textSize="16sp"
            android:letterSpacing="0.15" />
    </LinearLayout>

    <!-- Loading Container -->
    <FrameLayout
        android:id="@+id/fl_loading_container"
        android:layout_width="290dp"
        android:layout_height="56dp"
        android:layout_marginBottom="70dp"
        android:background="@drawable/ui_glass_card"
        android:elevation="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ProgressBar
            android:id="@+id/pb_loading"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/loading_button_progress" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="LOADING..."
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.1" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
