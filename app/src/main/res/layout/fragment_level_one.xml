<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#D1F1D4" 
    tools:context=".LevelOneFragment">
    <!-- Nền có thể dùng @drawable/hinh_nen nếu phù hợp, ở đây tôi dùng mã màu xanh lá cây nhạt (mô phỏng trời/cỏ) -->

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/hinh_nen"
        android:alpha="0.8" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/safe_top_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_begin="40dp" />

    <!-- Top Bar Container -->
    <LinearLayout
        android:id="@+id/ll_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="@id/safe_top_guideline">

        <!-- Back/Home Button (Left) -->
        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_prev"
            android:padding="6dp"
            android:background="@drawable/ui_round_btn_orange_bg"
            app:tint="#FFFFFF" />

        <!-- Gold Pill -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/ui_pill_yellow_bg"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="12dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🪙"
                android:textSize="16sp" />
            <TextView
                android:id="@+id/tv_game_gold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="15,840"
                android:textColor="#3E2723"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <!-- Level Indicator -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">
                <TextView
                    android:id="@+id/tv_level_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LEVEL 99"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:shadowColor="#000000"
                    android:shadowDx="1"
                    android:shadowDy="1"
                    android:shadowRadius="3" />
                <ProgressBar
                    android:id="@+id/pb_level_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="80dp"
                    android:layout_height="8dp"
                    android:layout_marginTop="2dp"
                    android:progress="40"
                    android:progressDrawable="@drawable/ui_progress_bar_layer" />
            </LinearLayout>
            <!-- Ngôi sao giữa progress bar -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="-6dp"
                android:text="⭐"
                android:textSize="18sp"
                android:shadowColor="#BCAAA4"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="1" />
        </FrameLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <!-- Gems Pill -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/ui_pill_white_bg"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="12dp"
            android:layout_marginEnd="8dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💎"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/tv_game_gems"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="320"
                android:textColor="#3E2723"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Reset Button -->
        <TextView
            android:id="@+id/btn_reset_level"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/ui_round_btn_orange_bg"
            android:gravity="center"
            android:text="🔄"
            android:textSize="18sp" />

        <!-- Settings Button -->
        <ImageView
            android:id="@+id/btn_settings"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_menu"
            android:padding="8dp"
            android:background="@drawable/ui_round_btn_orange_bg"
            android:backgroundTint="#42A5F5"
            app:tint="#FFFFFF" />
    </LinearLayout>

    <!-- Target Panel -->
    <FrameLayout
        android:id="@+id/fl_target_panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/ll_top_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/ui_target_panel_bg"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="12dp">
            
            <TextView
                android:id="@+id/tv_packed_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Collect: 0/15"
                android:textColor="#5D4037"
                android:textStyle="bold"
                android:textSize="16sp" />
            
            <!-- Fruit Icons mockup -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="🍑"
                android:textSize="18sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="🍇"
                android:textSize="18sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="🥦"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- Target Banner Overlay -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:background="@drawable/ui_target_title_bg"
            android:paddingHorizontal="16dp"
            android:paddingVertical="4dp"
            android:text="@string/target_label"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="12sp"
            android:shadowColor="#000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="1"/>
    </FrameLayout>

    <!-- Trucks Area -->
    <LinearLayout
        android:id="@+id/ll_boxes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@id/fl_target_panel">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/truck_container_a"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp">
            
            <ImageView
                android:id="@+id/img_truck_a"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:src="@drawable/truck_blue_photoroom"
                android:scaleType="fitCenter"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_box_a_fruit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="24sp"
                android:shadowColor="#000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="2"
                app:layout_constraintTop_toTopOf="@id/img_truck_a"
                app:layout_constraintBottom_toBottomOf="@id/img_truck_a"
                app:layout_constraintStart_toStartOf="@id/img_truck_a"
                app:layout_constraintEnd_toEndOf="@id/img_truck_a"
                app:layout_constraintHorizontal_bias="0.35"
                app:layout_constraintVertical_bias="0.45" />

            <TextView
                android:id="@+id/tv_box_a_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/glass_panel_bg"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                app:layout_constraintTop_toBottomOf="@id/img_truck_a"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/tv_box_a_turns"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:shadowColor="#000000"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="3"
                app:layout_constraintTop_toTopOf="@id/img_truck_a"
                app:layout_constraintBottom_toBottomOf="@id/img_truck_a"
                app:layout_constraintStart_toStartOf="@id/img_truck_a"
                app:layout_constraintEnd_toEndOf="@id/img_truck_a"
                app:layout_constraintHorizontal_bias="0.85"
                app:layout_constraintVertical_bias="0.30" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/truck_container_b"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp">
            
            <ImageView
                android:id="@+id/img_truck_b"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:src="@drawable/truck_blue_photoroom"
                android:tint="#FFC107"
                android:tintMode="multiply"
                android:scaleType="fitCenter"
                app:layout_constraintTop_toTopOf="parent" />
                
            <TextView
                android:id="@+id/tv_box_b_fruit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="24sp"
                android:shadowColor="#000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="2"
                app:layout_constraintTop_toTopOf="@id/img_truck_b"
                app:layout_constraintBottom_toBottomOf="@id/img_truck_b"
                app:layout_constraintStart_toStartOf="@id/img_truck_b"
                app:layout_constraintEnd_toEndOf="@id/img_truck_b"
                app:layout_constraintHorizontal_bias="0.35"
                app:layout_constraintVertical_bias="0.45" />

            <TextView
                android:id="@+id/tv_box_b_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/glass_panel_bg"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                app:layout_constraintTop_toBottomOf="@id/img_truck_b"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/tv_box_b_turns"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:shadowColor="#000000"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="3"
                app:layout_constraintTop_toTopOf="@id/img_truck_b"
                app:layout_constraintBottom_toBottomOf="@id/img_truck_b"
                app:layout_constraintStart_toStartOf="@id/img_truck_b"
                app:layout_constraintEnd_toEndOf="@id/img_truck_b"
                app:layout_constraintHorizontal_bias="0.85"
                app:layout_constraintVertical_bias="0.30" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>

    <!-- Game Board (3D Stacking Frame) -->
    <FrameLayout
        android:id="@+id/gl_game_board"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintBottom_toTopOf="@id/fl_bottom_area"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ll_boxes" />

    <!-- Bottom Area container (Dirt background) -->
    <FrameLayout
        android:id="@+id/fl_bottom_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#D28D69"
        android:paddingBottom="4dp"
        app:layout_constraintBottom_toBottomOf="parent">
        
        <!-- Curved top edge effect -->
        <View
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_gravity="top"
            android:layout_marginTop="-20dp"
            android:background="@drawable/ui_round_btn_orange_bg"
            android:backgroundTint="#D28D69" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <!-- Powerups -->
            <LinearLayout
                android:id="@+id/ll_powerups"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <!-- Reroll Button -->
                <FrameLayout
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_marginHorizontal="12dp">
                    <LinearLayout
                        android:id="@+id/btn_reroll_bags"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/ui_round_btn_orange_bg"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:clickable="true"
                        android:focusable="true">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🎲"
                            android:textSize="28sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/powerup_reroll_short"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF" />
                    </LinearLayout>
                    <!-- Badge -->
                    <TextView
                        android:id="@+id/tv_badge_reroll"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="top|end"
                        android:background="@drawable/ui_badge_red_bg"
                        android:gravity="center"
                        android:text="1"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <!-- Hint (Magnify) Button -->
                <FrameLayout
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:layout_marginHorizontal="8dp">
                    <LinearLayout
                        android:id="@+id/btn_magnify"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/ui_round_btn_orange_bg"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:clickable="true"
                        android:focusable="true">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🔍"
                            android:textSize="32sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/powerup_hint_short"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF" />
                    </LinearLayout>
                    <!-- Badge -->
                    <TextView
                        android:id="@+id/tv_badge_magnify"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="top|end"
                        android:background="@drawable/ui_badge_red_bg"
                        android:gravity="center"
                        android:text="5"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <!-- Shuffle Button -->
                <FrameLayout
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_marginHorizontal="12dp">
                    <LinearLayout
                        android:id="@+id/btn_reshuffle"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/ui_round_btn_orange_bg"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:clickable="true"
                        android:focusable="true">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🔀"
                            android:textSize="28sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/powerup_shuffle_short"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF" />
                    </LinearLayout>
                    <!-- Badge -->
                    <TextView
                        android:id="@+id/tv_badge_shuffle"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="top|end"
                        android:background="@drawable/ui_badge_red_bg"
                        android:gravity="center"
                        android:text="2"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </FrameLayout>
            </LinearLayout>

            <!-- Banner Ads moved inside here -->
            <FrameLayout
                android:id="@+id/ad_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="50dp" />

        </LinearLayout>
    </FrameLayout>

    <!-- Overlays -->
    <include
        android:id="@+id/layout_settings"
        layout="@layout/dialog_settings"
        android:visibility="gone" />

    <include
        android:id="@+id/layout_win_dialog"
        layout="@layout/dialog_win"
        android:visibility="gone" />

    <include
        android:id="@+id/layout_lose_dialog"
        layout="@layout/dialog_lose"
        android:visibility="gone" />

</androidx.constraintlayout.widget.ConstraintLayout>