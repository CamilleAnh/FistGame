<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardBackgroundColor="#1A1835"
    app:cardCornerRadius="18dp"
    app:cardElevation="8dp"
    app:strokeColor="#3D376A"
    app:strokeWidth="1.5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Rarity Badge Pill -->
        <TextView
            android:id="@+id/tv_skin_rarity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/ui_badge_red_bg"
            android:fontFamily="sans-serif-black"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:text="COMMON"
            android:textColor="#FFFFFF"
            android:textSize="9sp"
            android:letterSpacing="0.05"
            android:elevation="4dp"
            android:layout_marginBottom="6dp" />

        <!-- Crate Box Preview Frame -->
        <FrameLayout
            android:layout_width="72dp"
            android:layout_height="96dp"
            android:background="@drawable/ui_glass_card_premium"
            android:padding="4dp">

            <View
                android:id="@+id/view_skin_color"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/tv_skin_emoji"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textSize="26sp"
                android:shadowColor="#CC000000"
                android:shadowDx="1"
                android:shadowDy="3"
                android:shadowRadius="4" />

        </FrameLayout>

        <!-- Skin name -->
        <TextView
            android:id="@+id/tv_skin_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-black"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Price or SELECTED status -->
        <TextView
            android:id="@+id/tv_skin_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="#B0BEC5"
            android:textSize="11sp" />

        <!-- Buy / Equip button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_skin_action"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:textSize="10sp"
                android:fontFamily="sans-serif-black"
                android:textColor="#FFFFFF"
                android:contentDescription="Equip or buy skin"
                app:cornerRadius="16dp"
                app:elevation="4dp" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
