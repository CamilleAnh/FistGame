<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Lớp 1: Bóng đổ phía dưới -->
    <item android:top="8dp" android:left="6dp" android:right="2dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#22000000" />
            <corners android:radius="8dp" />
        </shape>
    </item>

    <!-- Lớp 2: Thân hộp chính màu Vàng Hoàng Gia -->
    <item android:bottom="3dp" android:right="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#D4AF37" /> <!-- Màu Gold -->
            <corners android:radius="12dp" />
            <stroke android:width="2dp" android:color="#AA7C11" />
        </shape>
    </item>

    <!-- Lớp 3: Mặt trước màu gradient sáng -->
    <item android:top="6dp" android:bottom="5dp" android:left="2dp" android:right="5dp">
        <shape android:shape="rectangle">
            <gradient 
                android:startColor="#FFF9C4" 
                android:endColor="#FBC02D" 
                android:angle="90" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</layer-list>
